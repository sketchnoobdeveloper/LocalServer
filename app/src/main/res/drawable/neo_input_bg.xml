<?xml version="1.0" encoding="utf-8"?>
<!-- Inset look for inputs -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_surface_alt" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/neo_divider" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_highlight" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_surface_alt" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
