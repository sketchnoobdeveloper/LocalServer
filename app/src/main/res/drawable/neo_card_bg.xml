<?xml version="1.0" encoding="utf-8"?>
<!-- Neomorphism raised card: dark shadow bottom-right + light highlight top-left -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer dark shadow (bottom-right) -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_shadow_soft" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Light highlight (top-left) -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_highlight" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Surface fill -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neo_surface" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
