<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SNDShield" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_soft</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_on_brand</item>

        <item name="android:colorBackground">@color/neo_bg</item>
        <item name="colorSurface">@color/neo_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="android:windowBackground">@color/neo_bg</item>
        <item name="android:statusBarColor">@color/neo_bg</item>
        <item name="android:navigationBarColor">@color/neo_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:fontFamily">sans-serif</item>

        <item name="android:windowAnimationStyle">@style/Anim.Window</item>
    </style>

    <style name="Theme.SNDShield.Splash" parent="Theme.SNDShield">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Anim.Window" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Text styles -->
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Heading" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Stat.Number" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Stat.Label" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Neo card -->
    <style name="Neo.Card" parent="">
        <item name="android:background">@drawable/neo_card_bg</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Neo.Card.Small" parent="Neo.Card">
        <item name="android:padding">12dp</item>
    </style>

    <!-- Neo button -->
    <style name="Neo.Button" parent="">
        <item name="android:background">@drawable/neo_button_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Neo.Button.Primary" parent="Neo.Button">
        <item name="android:background">@drawable/neo_button_primary_bg</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Neo.Button.Danger" parent="Neo.Button">
        <item name="android:background">@drawable/neo_button_danger_bg</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="Neo.IconButton" parent="">
        <item name="android:background">@drawable/neo_icon_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/text_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Neo input -->
    <style name="Neo.Input" parent="">
        <item name="android:background">@drawable/neo_input_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Section headers -->
    <style name="Section.Header" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
