<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    style="@style/Neo.Card.Small">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/neo_circle_bg">

        <ImageView
            android:id="@+id/ruleIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_filter"
            android:tint="@color/brand_primary"
            android:contentDescription="@string/tool_sms_rules" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ruleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+8801XXXXXXXXX"
            style="@style/Text.Heading"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ruleSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Block — added today"
            style="@style/Text.Caption" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/ruleSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:thumbTint="@color/brand_primary"
        android:trackTint="@color/neo_divider"
        android:checked="true" />
</LinearLayout>
